datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["payproof"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

enum WalletRole {
  EMPLOYER
  CONTRACTOR

  @@schema("payproof")
}

enum ReceiptStatus {
  PENDING
  CONFIRMED
  FAILED

  @@schema("payproof")
}

model WalletIdentity {
  id        String     @id @default(uuid())
  publicKey String     @unique
  role      WalletRole
  nonceHash String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@schema("payproof")
}

model Receipt {
  id                   String        @id @default(uuid())
  issuerPublicKey      String
  recipientPublicKey   String
  transactionSignature String        @unique
  mintAddress          String
  receiptHash          String        @unique
  encryptedEnvelope    Bytes
  status               ReceiptStatus @default(PENDING)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  disclosures          Disclosure[]

  @@schema("payproof")
}

model Disclosure {
  id               String    @id @default(uuid())
  receiptId        String
  tokenHash        String    @unique
  fields           Json
  encryptedPayload Bytes
  payloadSignature Bytes
  payloadVersion   Int       @default(1)
  expiresAt        DateTime
  revokedAt        DateTime?
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  receipt          Receipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@schema("payproof")
}

model AuditEvent {
  id        String   @id @default(uuid())
  actorKey  String?
  eventType String
  subjectId String
  metadata  Json
  createdAt DateTime @default(now())

  @@schema("payproof")
}
